# ==========================================================
# nu11secur1ty - Windows Auto-Restart RESTORE Script
# Purpose: Re-enable default Windows update behavior
# ==========================================================

Write-Host "Restoring Micky Mouse default settings..." -ForegroundColor Yellow

# 1. Remove the Auto-Reboot block from Registry
$registryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU"
if (Test-Path $registryPath) {
    Remove-ItemProperty -Path $registryPath -Name "NoAutoRebootWithLoggedOnUsers" -ErrorAction SilentlyContinue
    Write-Host "[+] Registry: Auto-Reboot block removed." -ForegroundColor Green
}

# 2. Re-enable tasks in Task Scheduler
$tasks = @(
    "\Microsoft\Windows\UpdateOrchestrator\Reboot",
    "\Microsoft\Windows\UpdateOrchestrator\Reboot_AC",
    "\Microsoft\Windows\UpdateOrchestrator\Reboot_Battery"
)

foreach ($taskPath in $tasks) {
    try {
        Enable-ScheduledTask -TaskPath (Split-Path $taskPath -Parent) -TaskName (Split-Path $taskPath -Leaf) -ErrorAction SilentlyContinue
        Write-Host "[+] Task Scheduler: Re-enabled $taskPath" -ForegroundColor Green
    } catch {
        Write-Host "[-] Task Scheduler: Could not find $taskPath to enable." -ForegroundColor Gray
    }
}

# 3. Restore Permissions to the Reboot task file (if they were changed)
$rebootFile = "$env:windir\System32\Tasks\Microsoft\Windows\UpdateOrchestrator\Reboot"
if (Test-Path $rebootFile) {
    icacls $rebootFile /reset
    Write-Host "[+] File System: Permissions reset for Reboot task file." -ForegroundColor Green
}

# 4. Force apply the policies back to default
gpupdate /force

Write-Host "==========================================================" -ForegroundColor Yellow
Write-Host "RESTORE COMPLETE! Windows is back to default behavior." -ForegroundColor White
Write-Host "==========================================================" -ForegroundColor Yellow
