# ==========================================================
# nu11secur1ty - Windows Auto-Restart RESTORE Script
# Purpose: Re-enable default Windows update behavior
# ==========================================================

Write-Host "Restoring Micky Mouse default settings..." -ForegroundColor Yellow

# 1. Clearing the registers (We remove our bans)
$regPaths = @(
    "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU",
    "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update"
)

foreach ($path in $regPaths) {
    if (Test-Path $path) {
        Remove-ItemProperty -Path $path -Name "NoAutoRebootWithLoggedOnUsers" -ErrorAction SilentlyContinue
        Remove-ItemProperty -Path $path -Name "AUOptions" -ErrorAction SilentlyContinue
        Write-Host "[+] Registry: Restrictions removed from $path" -ForegroundColor Green
    }
}

# 2. Unlocking the task file (Returning rights)
# Това е критично, за да може Windows изобщо да "види" задачата отново
$taskFile = "$env:windir\System32\Tasks\Microsoft\Windows\UpdateOrchestrator\Reboot"
if (Test-Path $taskFile) {
    # Връщаме собствеността на SYSTEM и нулираме правата
    icacls $taskFile /setowner "NT AUTHORITY\SYSTEM" /c /t | Out-Null
    icacls $taskFile /reset | Out-Null
    Write-Host "[+] File System: Permissions reset for Reboot task file." -ForegroundColor Green
}

# 3. Returning tasks to Task Scheduler
$tasks = @(
    "\Microsoft\Windows\UpdateOrchestrator\Reboot",
    "\Microsoft\Windows\UpdateOrchestrator\Reboot_AC",
    "\Microsoft\Windows\UpdateOrchestrator\Reboot_Battery"
)

foreach ($taskPath in $tasks) {
    try {
        Enable-ScheduledTask -TaskName (Split-Path $taskPath -Leaf) -TaskPath (Split-Path $taskPath -Parent) -ErrorAction SilentlyContinue
        Write-Host "[+] Task Scheduler: Re-enabled $taskPath" -ForegroundColor Green
    } catch {
        Write-Host "[-] Task Scheduler: Could not enable $taskPath" -ForegroundColor Gray
    }
}

# 4. Enforcing policies
gpupdate /force | Out-Null

Write-Host "==========================================================" -ForegroundColor Yellow
Write-Host "RESTORE COMPLETE! Windows is back to default behavior." -ForegroundColor White
Write-Host "==========================================================" -ForegroundColor Yellow

# --- CHECK STATUS ---
Write-Host "[!] FINAL VERIFICATION:" -ForegroundColor Cyan
$verify = Get-ItemProperty -Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU" -ErrorAction SilentlyContinue
if ($null -eq $verify.NoAutoRebootWithLoggedOnUsers) {
    Write-Host "[CLEAN] NoAutoReboot restriction is GONE." -ForegroundColor Green
} else {
    Write-Host "[STILL THERE] Restriction persists. Manual check needed." -ForegroundColor Red
}
